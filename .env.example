NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/drivex
DB_SSL=false
TRUST_PROXY=false
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
DEMO_OWNER_PASSWORD=admin123
DEMO_STAFF_PASSWORD=staff1234
ADMIN_EMAIL=admin@drivex.com
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=DriveX Owner
# Optional - set both to also seed a Platform Admin account (npm run seed:admin). Leave unset
# to skip it (only the vendor-scoped OWNER above gets created).
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_FULL_NAME=Drive X Platform Admin
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:3000
ADMIN_WEB_ORIGIN=http://localhost:3000

# Free account at https://cloudinary.com/users/register/free - credentials are
# under Dashboard > Product Environment Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
